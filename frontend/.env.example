# ==========================================
# EduVault Frontend — Environment Variables
# ==========================================

# URL of the deployed FastAPI backend on Render
# Example: https://eduvault-backend.onrender.com (without trailing slash)
NEXT_PUBLIC_API_URL=https://eduvault-backend.onrender.com

# Optional: Dedicated WebSocket base if different from API (defaults to NEXT_PUBLIC_API_URL with wss://)
# NEXT_PUBLIC_WS_URL=wss://eduvault-backend.onrender.com
