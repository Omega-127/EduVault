# Global Configuration for EduVault

# Application
APP_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-32-char-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Relational Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eduvault
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/eduvault

# Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eduvault-docs

# Task Queue (Redis)
REDIS_URL=redis://redis:6379/0

# Vector Database (chromadb / qdrant / pgvector)
VECTOR_DB=chromadb
CHROMA_HOST=chromadb
CHROMA_PORT=8001
QDRANT_URL=http://qdrant:6333

# Embedding Provider
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# RAG Parameters
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.35
