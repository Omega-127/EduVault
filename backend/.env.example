# ===============================================
# EduVault Backend — Environment Variables Template
# ===============================================

APP_ENV=production
PORT=8000
SECRET_KEY=replace-with-a-secure-random-secret-key

# Allowed CORS origins (comma-separated list, including your Vercel deployment URL)
CORS_ORIGINS=https://your-project.vercel.app,http://localhost:3000

# Database URL (Render PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname)
# For local dev without Postgres, sqlite+aiosqlite:///./eduvault.db can also be used
DATABASE_URL=postgresql+asyncpg://eduvault:password@localhost:5432/eduvault

# LLM Selection (gemini or groq)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Vector Database
VECTOR_DB=chromadb
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Retrieval & Guardrails
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.35

# JWT Auth Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
=======
# Application
APP_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Relational Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eduvault

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eduvault-docs

# Task Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Vector Database (chromadb / qdrant / pgvector)
VECTOR_DB=chromadb
CHROMA_HOST=localhost
CHROMA_PORT=8001
QDRANT_URL=http://localhost:6333

# Embedding Provider (all-MiniLM-L6-v2 / gemini)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Provider (gemini / groq)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# RAG Parameters
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.35
