# Application
APP_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Relational Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eduvault

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eduvault-docs

# Task Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Vector Database (chromadb / qdrant / pgvector)
VECTOR_DB=chromadb
CHROMA_HOST=localhost
CHROMA_PORT=8001
QDRANT_URL=http://localhost:6333

# Embedding Provider (all-MiniLM-L6-v2 / gemini)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Provider (gemini / groq)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# RAG Parameters
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.35
